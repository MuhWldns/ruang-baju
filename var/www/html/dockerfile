# Gunakan image PHP 7.4 dengan Apache
FROM php:7.4-apache

# Install ekstensi PHP yang relevan
RUN apt-get update && apt-get install -y \
    libpng-dev \
    libjpeg-dev \
    libfreetype6-dev \
    libzip-dev \
    unzip \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        mysqli \
        pdo_mysql \
        mbstring \
        fileinfo \
        gd \
        zip

# Aktifkan mod_rewrite Apache jika suatu saat kamu menambahkan .htaccess
RUN a2enmod rewrite

# Salin semua file proyek ke folder hosting Apache
COPY . /var/www/html/

# Berikan hak akses yang sesuai (opsional, tergantung permission)
RUN chown -R www-data:www-data /var/www/html

# Opsional: Aktifkan display error untuk debugging
RUN echo "display_errors=On\nerror_reporting=E_ALL" > /usr/local/etc/php/conf.d/docker-php-errors.ini
